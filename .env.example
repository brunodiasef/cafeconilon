# Copie este arquivo para .env e preencha.
# Chave da API do Claude (console.anthropic.com). Sem ela o app roda em modo demonstração.
ANTHROPIC_API_KEY=
# Código que os produtores de teste digitam uma vez no app (deixe vazio para não pedir código).
CODIGO_ACESSO=
# Máximo de análises por hora por aparelho/conexão.
LIMITE_POR_HORA=30
